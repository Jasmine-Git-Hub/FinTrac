rules_version = '2';

// Deny-by-default rules for the free Spark plan (no Cloud Functions).
// The only cross-user write allowed is a jar owner sending a jar invite.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function jarParticipants(jarId) {
      return get(/databases/$(database)/documents/jars/$(jarId)).data.participants;
    }

    match /users/{uid} {
      // Single profiles are readable so shared jars can show participant names.
      // Queries are capped at 1 result (the invite-by-email lookup) so the user list can't be dumped.
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 1;
      allow create, update, delete: if isUser(uid);

      // A jar owner may drop a JAR_INVITE into the invitee's inbox; everything else is owner-only.
      match /notifications/{notificationId} {
        allow read, update, delete: if isUser(uid);
        allow create: if isUser(uid)
          || (signedIn()
              && request.resource.data.type == 'JAR_INVITE'
              && request.resource.data.inviterId == request.auth.uid
              && get(/databases/$(database)/documents/jars/$(request.resource.data.jarId)).data.createdBy
                   == request.auth.uid);
      }

      // bills, challenges, jars, transactions, etc.: owner only
      match /{subcollection}/{docId} {
        allow read, write: if isUser(uid) && subcollection != 'notifications';
      }
    }

    match /jars/{jarId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants;

      // Only existing participants may update and the owner can't be changed.
      // The owner may add (invite) and remove people; anyone else may only leave,
      // and may only change their own contribution entry.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          request.auth.uid == resource.data.createdBy
          || (
            request.resource.data.participants.toSet().hasOnly(resource.data.participants.toSet())
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants'])
              || request.resource.data.participants.toSet()
                   == resource.data.participants.toSet().difference([request.auth.uid].toSet())
            )
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participantContributions'])
              || request.resource.data.participantContributions
                   .diff(resource.data.participantContributions).affectedKeys()
                   .hasOnly([request.auth.uid])
            )
          )
        );

      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;
    }

    // Shared-jar activity (written by JarFirestoreManager / FirestoreHelper)
    match /transactions/{txId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || request.auth.uid in jarParticipants(resource.data.jarId));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.auth.uid in jarParticipants(request.resource.data.jarId);
      allow delete: if signedIn()
        && request.auth.uid in jarParticipants(resource.data.jarId);
    }

    match /jarTransactions/{txId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || request.auth.uid in jarParticipants(resource.data.jarId));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.auth.uid in jarParticipants(request.resource.data.jarId);
    }

    // Everything else (including legacy root /bills and /test_connection) is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

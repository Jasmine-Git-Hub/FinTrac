<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_input_rounded"
    android:backgroundTint="@color/card_background"
    android:clipToOutline="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/account_options"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A888888"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/btnMenuEditProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit_profile"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        app:drawableStartCompat="@android:drawable/ic_menu_edit"
        app:drawableTint="@color/blue"
        android:drawablePadding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/btnMenuLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/log_out"
        android:textColor="#E53935"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        app:drawableStartCompat="@android:drawable/ic_lock_power_off"
        app:drawableTint="#E53935"
        android:drawablePadding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/btnMenuCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        app:drawableStartCompat="@android:drawable/ic_menu_close_clear_cancel"
        app:drawableTint="@color/text_secondary"
        android:drawablePadding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>